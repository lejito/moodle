# Se copia como .env (que git ignora) y se completa. Jenkins lo lee al arrancar.

# El repositorio que Jenkins construye, rama main.
REPOSITORIO=https://github.com/sepita1234/moodle.git

# Contraseña del usuario admin de Jenkins.
JENKINS_ADMIN_PASSWORD=cambiar-esta-clave

# Token de análisis global de SonarQube (Mi cuenta > Seguridad > Generar token, tipo Global Analysis).
SONAR_TOKEN=

# SonarQube corre en Windows; desde Docker se llega al equipo por host.docker.internal.
SONAR_HOST_URL=http://host.docker.internal:9000

# Puerto del Moodle desplegado por el pipeline: http://localhost:8000.
PUERTO=8000
