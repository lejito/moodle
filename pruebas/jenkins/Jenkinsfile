// Pipeline del proyecto de pruebas de software sobre Moodle, en el Jenkins local (pruebas/jenkins).
//
//   1. Pruebas unitarias: PHPUnit con cobertura, una etapa por funcionalidad.
//   2. Análisis de calidad: SonarQube con la cobertura, y el build falla si no se cumple el umbral.
//   3. Despliegue: una imagen de Moodle con este código, instalada y sembrada desde cero, en
//      http://localhost:8000 (o el puerto de PUERTO en .env).
//   4. Prueba de humo: la interfaz y la API REST del Moodle desplegado responden.
//   5. Pruebas E2E: Cypress contra el Moodle desplegado (pruebas/cypress/flujos).
//   6. Pruebas de API: Cypress contra los servicios web REST del Moodle desplegado (pruebas/cypress/api).
//   7. Pruebas BDD: escenarios Gherkin con Screenplay (Cucumber, Serenity/JS y Playwright) contra el
//      Moodle desplegado (pruebas/bdd).
//   8. Pruebas de accesibilidad: axe-core, teclado y reflujo con Cypress (pruebas/cypress/accesibilidad).
//   9. Pruebas de seguridad: el OWASP Top 10 sobre las funcionalidades, con Cypress (pruebas/cypress/seguridad).
//  10. Auditoría de seguridad: composer audit, npm audit y ZAP baseline (pruebas/seguridad/auditar.sh).
//      Informa los avisos, no hace fallar el build.
//
// Las etapas de cada funcionalidad y sonar.sources / sonar.exclusions de sonar-project.properties van
// juntas: si cambia una funcionalidad, cambian las dos. Cada etapa de pruebas corre aunque falle una
// anterior; el análisis y el despliegue solo corren si todas pasaron, y las suites contra el Moodle
// desplegado (E2E, API, BDD, accesibilidad y seguridad), si el despliegue pasó la prueba de humo.
//
// OMITIR, en el .env de Jenkins, lista etapas que el pipeline se salta (unitarias, calidad, e2e, api,
// bdd, accesibilidad, seguridad, auditoria), para probar una nueva sin esperar las demás. Vacío, que es
// lo normal, corre todo.

def pruebas(String nombre, String carpetas) {
  catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
    sh "bash pruebas/jenkins/php.sh ejecutar bash pruebas/ci/phpunit.sh ${nombre} ${carpetas}"
  }
}

def todoBien() {
  return currentBuild.currentResult == 'SUCCESS'
}

/** Si la etapa está en OMITIR. Las pruebas unitarias se llevan con ellas el análisis, que usa su cobertura. */
def omitir(String etapa) {
  // Sin operador de propagación (*.): la transformación CPS de Jenkins no lo admite.
  def omitidas = ',' + (env.OMITIR ?: '').replace(' ', '') + ','
  return omitidas.contains(",${etapa},") || (etapa == 'calidad' && omitidas.contains(',unitarias,'))
}

/**
 * Corre una suite de Node (Cypress o Cucumber) en un contenedor que comparte la red del Moodle
 * desplegado: ahí localhost:PUERTO es su Apache, y Moodle exige esa dirección (wwwroot). Cada caso se
 * prepara con preparar.php, por docker exec en ese mismo contenedor. Publica el JUnit de
 * pruebas/reportes/<suite>/junit y archiva todo el reporte.
 */
def suiteContraElDespliegue(String suite, String imagen, String dockerfile, String comando) {
  try {
    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
      sh "docker build -q -t ${imagen} -f pruebas/docker/${dockerfile} pruebas/docker"
      sh "rm -rf pruebas/reportes/${suite}"
      sh """
        docker run --rm --volumes-from "\$(hostname)" -w "\$WORKSPACE/pruebas" \
          --network container:moodle-despliegue-web-1 \
          -v /var/run/docker.sock:/var/run/docker.sock \
          -e MOODLE_URL="http://localhost:\$PUERTO" \
          -e PREPARAR="docker exec moodle-despliegue-web-1 php pruebas/seed/preparar.php" \
          ${imagen} sh ci/node.sh ${comando}
      """
    }
  } finally {
    junit allowEmptyResults: true, testResults: "pruebas/reportes/${suite}/junit/*.xml"
    archiveArtifacts allowEmptyArchive: true, artifacts: "pruebas/reportes/${suite}/**"
    sh 'docker run --rm --volumes-from "$(hostname)" alpine:3.22 chown -R "$(id -u):$(id -g)" "$WORKSPACE/pruebas"'
  }
}

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '15'))
    timeout(time: 3, unit: 'HOURS')
  }

  environment {
    PUERTO = "${env.PUERTO ?: '8000'}"
  }

  stages {
    stage('Preparar el sitio de pruebas') {
      when { expression { !omitir('unitarias') } }
      steps {
        sh 'docker build -t moodle-pruebas/php:8.4 pruebas/docker'
        sh 'rm -rf coverage reports && cp pruebas/docker/config.php config.php'
        sh 'bash pruebas/jenkins/php.sh iniciar'
        // init.php instala las dependencias de Composer y el sitio de pruebas; --buildcomponentconfigs
        // genera un phpunit.xml por componente, cuya cobertura mide solo ese componente.
        sh 'bash pruebas/jenkins/php.sh ejecutar php public/admin/tool/phpunit/cli/init.php --no-composer-self-update'
        sh 'bash pruebas/jenkins/php.sh ejecutar php public/admin/tool/phpunit/cli/util.php --buildcomponentconfigs'
      }
    }

    // Los componentes de cada funcionalidad se repiten en pruebas/unitarias.sh, que corre
    // las mismas pruebas en local, y en sonar-project.properties: si cambian aquí, allá también.
    stage('Pruebas unitarias') {
      when { expression { !omitir('unitarias') } }
      stages {
        stage('RF-MOOD-01 · enrol_self') {
          steps { script { pruebas('enrol_self', 'public/enrol/self') } }
        }
        stage('RF-MOOD-02 y 03 · mod_assign') {
          steps { script { pruebas('mod_assign', 'public/mod/assign') } }
        }
        stage('RF-MOOD-02 · assignsubmission') {
          steps {
            script {
              pruebas('assignsubmission',
                'public/mod/assign/submission/onlinetext public/mod/assign/submission/file')
            }
          }
        }
        stage('RF-MOOD-04 · mod_quiz') {
          steps { script { pruebas('mod_quiz', 'public/mod/quiz') } }
        }
        // Todas las reglas de acceso salvo Safe Exam Browser (seb), que ninguna funcionalidad usa.
        stage('RF-MOOD-04 · quizaccess') {
          steps {
            script {
              pruebas('quizaccess', [
                'delaybetweenattempts', 'ipaddress', 'numattempts', 'offlineattempts',
                'openclosedate', 'password', 'securewindow', 'timelimit',
              ].collect { "public/mod/quiz/accessrule/${it}" }.join(' '))
            }
          }
        }
        stage('RF-MOOD-05 · mod_forum') {
          steps { script { pruebas('mod_forum', 'public/mod/forum') } }
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'reports/*.xml'
          archiveArtifacts allowEmptyArchive: true, artifacts: 'coverage/*.xml'
          // Los contenedores de las pruebas se van antes del análisis, para liberar memoria.
          sh 'bash pruebas/jenkins/php.sh terminar'
        }
      }
    }

    stage('Análisis de calidad') {
      when { expression { todoBien() && !omitir('calidad') } }
      steps {
        // El escáner corre en su propio contenedor, sobre el mismo clon. qualitygate.wait espera el
        // resultado del umbral y hace fallar el build si no se cumple.
        withSonarQubeEnv('SonarQube') {
          sh '''
            docker run --rm --volumes-from "$(hostname)" -w "$WORKSPACE" \
              -e SONAR_HOST_URL -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" -e SONAR_SCANNER_OPTS=-Xmx512m \
              sonarsource/sonar-scanner-cli:12.4.0.4321_8.4.0 \
              -Dsonar.projectKey=moodle-pruebas \
              -Dsonar.projectName="Moodle - pruebas de software" \
              -Dsonar.php.coverage.reportPaths="$(ls coverage/*.xml | paste -sd, -)" \
              -Dsonar.scanner.skipJreProvisioning=true \
              -Dsonar.qualitygate.wait=true
          '''
        }
      }
    }

    stage('Despliegue') {
      when { expression { todoBien() } }
      steps {
        // La imagen lleva el código y vendor/ adentro. Cada despliegue parte de cero: base de datos y
        // datos nuevos, para que las pruebas E2E y de API encuentren siempre lo mismo.
        sh 'docker build -f pruebas/docker/despliegue.Dockerfile -t moodle-pruebas/app:latest .'
        dir('pruebas/docker') {
          sh '''
            export COMPOSE_FILE=compose.despliegue.yml
            docker compose down -v
            docker compose run --rm -T moodle php admin/cli/install_database.php --agree-license --lang=en \
              --fullname="Moodle de pruebas" --shortname="Pruebas" \
              --adminuser=admin --adminpass='Pruebas-2026' --adminemail=admin@example.com
            docker compose run --rm -T moodle php pruebas/seed/sembrar.php
            docker compose run --rm -T moodle php pruebas/seed/servicios_web.php
            docker compose up -d web cron
            mkdir -p ../reportes
            docker compose run --rm -T --no-deps moodle cat pruebas/reportes/servicios-web.json > ../reportes/servicios-web.json
          '''
        }
      }
    }

    // Moodle exige que la dirección coincida con su wwwroot (localhost:PUERTO). Desde el contenedor de
    // Jenkins, ese puerto está en host.docker.internal; curl se conecta ahí sin cambiar la dirección.
    stage('Prueba de humo') {
      when { expression { todoBien() } }
      steps {
        sh '''
          HUMO_CONECTAR="localhost:$PUERTO:host.docker.internal:$PUERTO" \
            bash pruebas/ci/humo.sh "http://localhost:$PUERTO" pruebas/reportes/servicios-web.json
        '''
        script { env.DESPLEGADO = 'si' }
      }
    }

    // Las suites contra el despliegue son independientes: cada una corre aunque falle otra.
    stage('Pruebas E2E') {
      when { expression { env.DESPLEGADO == 'si' && !omitir('e2e') } }
      steps {
        script {
          suiteContraElDespliegue('e2e', 'moodle-pruebas/cypress:16.2.1', 'cypress.Dockerfile', 'npx cypress run --config-file cypress.config.js')
        }
      }
    }

    stage('Pruebas de API') {
      when { expression { env.DESPLEGADO == 'si' && !omitir('api') } }
      steps {
        script {
          suiteContraElDespliegue('api', 'moodle-pruebas/cypress:16.2.1', 'cypress.Dockerfile', 'npx cypress run --config-file cypress.api.config.js')
        }
      }
    }

    stage('Pruebas BDD') {
      when { expression { env.DESPLEGADO == 'si' && !omitir('bdd') } }
      steps {
        script {
          suiteContraElDespliegue('bdd', 'moodle-pruebas/playwright:1.64.1', 'playwright.Dockerfile', 'npx cucumber-js bdd/features')
        }
      }
    }

    stage('Pruebas de accesibilidad') {
      when { expression { env.DESPLEGADO == 'si' && !omitir('accesibilidad') } }
      steps {
        script {
          suiteContraElDespliegue('accesibilidad', 'moodle-pruebas/cypress:16.2.1', 'cypress.Dockerfile',
            'npx cypress run --config-file cypress.accesibilidad.config.js')
        }
      }
    }

    stage('Pruebas de seguridad') {
      when { expression { env.DESPLEGADO == 'si' && !omitir('seguridad') } }
      steps {
        script {
          suiteContraElDespliegue('seguridad', 'moodle-pruebas/cypress:16.2.1', 'cypress.Dockerfile',
            'npx cypress run --config-file cypress.seguridad.config.js')
        }
      }
    }

    // Revisión de dependencias y análisis dinámico. Los avisos quedan en el reporte (resumen.md y el
    // HTML de ZAP); el build solo falla si una herramienta no pudo correr.
    stage('Auditoría de seguridad') {
      when { expression { env.DESPLEGADO == 'si' && !omitir('auditoria') } }
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
          sh '''
            MONTAJE="--volumes-from $(hostname)" RUTA="$WORKSPACE" \
            RED_MOODLE=moodle-despliegue-web-1 URL_MOODLE="http://localhost:$PUERTO" \
              bash pruebas/seguridad/auditar.sh
          '''
        }
      }
      post {
        always {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'pruebas/reportes/auditoria/**'
        }
      }
    }
  }

  post {
    always {
      // Por si el build se canceló a mitad de las pruebas unitarias.
      sh 'bash pruebas/jenkins/php.sh terminar'
    }
  }
}
