# Reportes que generan las pruebas en local (cobertura, resultados).
reportes/

# Dependencias de JavaScript de las pruebas E2E (npm ci).
node_modules/

# Claves de las pruebas con IA (Gemini, Cypress Cloud): cada uno pone las suyas, nunca en git.
.env

# Presupuesto compartido de consultas a Gemini entre las suites con IA (stagehand/, deepeval/).
.cache/

