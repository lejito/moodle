# Claves de las pruebas con IA. Se copia como pruebas/.env (que git ignora) y se completa. Las suites
# con IA lo leen al arrancar; sin estas claves se saltan con un aviso, sin fallar.
#
# Todas gastan un cupo gratuito limitado: se corren a mano, y en Jenkins solo con el parámetro IA.

# Gemini, para Stagehand, DeepEval y el proveedor de IA de Moodle que DeepEval evalúa.
# Se crea gratis en https://aistudio.google.com/apikey (Get API key).
GOOGLE_GENERATIVE_AI_API_KEY=

# Cypress Cloud, solo para cy.prompt. Se crea gratis en https://cloud.cypress.io: un proyecto nuevo
# muestra el Project ID y, en Project settings > Record Keys, la clave de grabación.
CYPRESS_PROJECT_ID=
CYPRESS_RECORD_KEY=
